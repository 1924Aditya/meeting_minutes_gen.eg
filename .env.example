# SAMVAAD Environment Configuration
# Copy to .env and fill in values

# ── AI Backend ──────────────────────────────────────────────────
# LLM provider: "gemini" | "openai"
LLM_PROVIDER=gemini

# Gemini API Key (primary)
GEMINI_API_KEY=

# OpenAI (fallback, if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ── Whisper ─────────────────────────────────────────────────────
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
# Set to "cuda" if you have NVIDIA GPU

# ── Backend Server ───────────────────────────────────────────────
BACKEND_PORT=3001
AI_SERVICE_PORT=8766
AI_SERVICE_HOST=127.0.0.1
AI_WS_URL=ws://127.0.0.1:8766
CORS_ORIGIN=*

# Browser deployment
# Set this to the public WebSocket endpoint of the Node backend, for example:
# VITE_BACKEND_WS_URL=wss://api.example.com/ws
VITE_BACKEND_WS_URL=

# ── Storage ──────────────────────────────────────────────────────
# Leave blank to use default: %APPDATA%/samvaad
DATA_DIR=
