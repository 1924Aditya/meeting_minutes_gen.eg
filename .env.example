# SAMVAAD Environment Configuration
# Copy to .env and fill in values

# ── AI Backend ──────────────────────────────────────────────────
# LLM provider: "gemini" | "openai"
LLM_PROVIDER=gemini

# Gemini API Key (primary)
GEMINI_API_KEY=

# OpenAI (fallback, if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ── Whisper ─────────────────────────────────────────────────────
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
# Set to "cuda" if you have NVIDIA GPU

# ── Backend Server ───────────────────────────────────────────────
BACKEND_PORT=3001
AI_SERVICE_PORT=8766

# ── Storage ──────────────────────────────────────────────────────
# Leave blank to use default: %APPDATA%/samvaad
DATA_DIR=
